# Existing deployment settings. Do not commit a real .env file or session.
MODE=private
PREFIXES=.
PORT=3000

# Use either session variable. SESSION is base64(creds.json).
# SESSION_ID may be GURU~base64(gzip(creds.json)) from the current bot,
# or the same base64(creds.json) format accepted by SESSION.
SESSION=
SESSION_ID=GURU~

TZ=Africa/Nairobi
# Legacy variable accepted when TZ is not set:
TIME_ZONE=Africa/Nairobi

ANTICALL=off
ANTIDELETE=on
ANTIEDIT=on
AUTO_READ=off
# Blocks removals, demotions, and message deletion targeting group admins.
# Set to off only when the owner intentionally permits those actions.
ADMIN_PROTECTION=on
AUTO_REACT=off
# AUTO_REACT_MODE=all, groups, or dm; set AUTO_REACT=on to enable.
AUTO_REACT_MODE=all
# Optional comma-separated reaction emoji list.
AUTO_REACT_EMOJIS=🐾,⚡,💜
AUTO_VIEW=on
AUTO_LIKE=on
# Status emoji: use random for Toxic-MD style random reactions, or set one emoji such as ❤️.
STATUS_LIKE_EMOJI=random
# Legacy status settings are also accepted:
AUTO_READ_STATUS=true
AUTO_LIKE_STATUS=true

DM_PRESENCE=
GRP_PRESENCE=
USER_LID=

OWNER_NUMBER=
OWNER_NAME=Black Panther
BOT_NAME=Black Panther
BOT_PIC=https://raw.githubusercontent.com/koyoteh/BLACK-PANTHER/main/black/assets/black-panther.jpg
MENU_IMAGES=

CHANNEL_JID=120363431857319034@newsletter
CHANNEL_URL=https://whatsapp.com/channel/0029VbDh88NCMY0Fartkxm1g
HOSTING_URL=https://cheap.bothosting.gurutech.top
HOSTING_PROVIDER=Bothosting
GITHUB_REPO=koyoteh/BLACK-PANTHER

# Optional credentials for migrated provider-backed features. Keep real values
# in the deployment secret manager; do not commit them in this file.
PANTHER_API_KEY=
PANTHER_API_URL=
GCSE_KEY=
